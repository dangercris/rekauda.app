{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rekauda",
  // "account_id": "<your Cloudflare account id>",  // optional when only one account is logged in with wrangler
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],

  // Public domain (optional). With a custom domain on your Cloudflare zone, uncomment the route below.
  // GOTCHA: a `custom_domain` route does not turn workers.dev off by itself. Keep "workers_dev": true while the
  // links you already shared use the workers.dev URL, and set it to false only when nobody depends on it anymore.
  // "routes": [{ "pattern": "recaudaciones.example.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,

  // Geist TTFs are bundled for the link-preview card (src/worker/og-image.ts).
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],

  // The Vite build (dist/) is served as static assets. The Worker runs first for every path except hashed /assets/* and /icon.svg, so / and /admin get the boot JSON and /r/* gets link previews.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/icon.svg"]
  },

  // This branch runs the multi-tenant code as a single-tenant instance: one tenant is created on first use and every host maps to it.
  // The schema lives in migrations-cloud/ (a fresh install; existing instances upgrade through export/import, not in place).
  "vars": { "TENANCY": "single" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rekauda",
      // Printed by `wrangler d1 create rekauda`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations-cloud"
    }
  ],

  // Receipts/ (transfer screenshots / PDFs) are private: only served through the admin API.
  // Covers/ (collection cover images) live in the same bucket and are public via /api/covers/*, keyed in D1.
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      // Create it with `wrangler r2 bucket create rekauda-comprobantes`. scripts/pending.sh reads this name.
      "bucket_name": "rekauda-comprobantes"
    }
  ],

  // Re-encodes the generated link-preview card to JPEG (src/worker/og-image.ts).
  "images": { "binding": "IMAGES" },

  // namespace_id values are integers you pick; they must be unique within your Cloudflare account.
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOOKUP_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],

  // Secrets (never in this file), set with `wrangler secret put <NAME>`:
  //   ADMIN_PASSWORD: admin login (the session itself is an opaque token stored in D1, so there is no signing secret).
  //   FORWARD_TO: the treasurer's real inbox (must be a verified Email Routing destination address).
  //               The email() handler forwards EVERY inbound message there first (src/worker/email/handler.ts).
  // Inbound Deuna notifications: Cloudflare Email Routing must route the secret address on your domain
  // (Email > Email Routing > Routing rules > Custom address > "Send to a Worker" > rekauda),
  // and the treasurer sets that address as the email of the Deuna account.
  // Local dev reads these from .dev.vars; `secrets.required` also drives the generated Env types (pnpm types).
  "secrets": { "required": ["ADMIN_PASSWORD", "FORWARD_TO"] },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
