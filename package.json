{
  "name": "rekauda",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev:api": "node scripts/cloud-guard.mjs --refuse-branch",
    "dev:web": "node scripts/ensure-config.mjs && vite",
    "build": "node scripts/ensure-config.mjs && vite build",
    "deploy": "node scripts/cloud-guard.mjs --refuse-branch",
    "types": "node scripts/cloud-guard.mjs --refuse-branch",
    "typecheck": "node scripts/ensure-config.mjs && tsc -p src/worker/tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit",
    "test": "node scripts/ensure-config.mjs && vitest run",
    "db:migrate:local": "node scripts/cloud-guard.mjs --refuse-branch",
    "db:migrate:remote": "node scripts/cloud-guard.mjs --refuse-branch",
    "cloud:guard": "node scripts/ensure-config.mjs && node scripts/cloud-guard.mjs --local",
    "cloud:migrate:local": "node scripts/ensure-config.mjs && node scripts/cloud-wrangler.mjs d1 migrations apply DB",
    "cloud:seed:local": "node scripts/ensure-config.mjs && node scripts/cloud-wrangler.mjs d1 execute DB --file scripts/cloud-seed.local.sql",
    "cloud:dev": "node scripts/ensure-config.mjs && node scripts/cloud-wrangler.mjs dev --port 8799",
    "cloud:types": "node scripts/ensure-config.mjs && node scripts/cloud-wrangler.mjs types",
    "sandbox:guard": "node scripts/ensure-config.mjs && node scripts/cloud-guard.mjs --sandbox",
    "sandbox:migrate": "node scripts/ensure-config.mjs && node scripts/cloud-wrangler.mjs sandbox:migrate",
    "sandbox:seed": "node scripts/ensure-config.mjs && node scripts/cloud-wrangler.mjs sandbox:seed",
    "sandbox:deploy": "node scripts/ensure-config.mjs && node scripts/cloud-wrangler.mjs sandbox:deploy",
    "sandbox:status": "node scripts/ensure-config.mjs && node scripts/cloud-wrangler.mjs sandbox:status",
    "prod:guard": "node scripts/cloud-guard.mjs --production",
    "prod:migrate": "node scripts/cloud-wrangler.mjs prod:migrate",
    "prod:deploy": "node scripts/cloud-wrangler.mjs prod:deploy",
    "prod:switch-apex": "node scripts/cloud-wrangler.mjs prod:switch-apex",
    "prod:status": "node scripts/cloud-wrangler.mjs prod:status",
    "pilot:export": "node scripts/cloud-wrangler.mjs pilot:export",
    "pilot:cleanup": "node scripts/cloud-wrangler.mjs pilot:cleanup",
    "pilot:import:plan": "node scripts/cloud-wrangler.mjs pilot:import:plan",
    "pilot:demo-workdir": "node scripts/cloud-wrangler.mjs pilot:demo-workdir",
    "prod:import": "node scripts/cloud-wrangler.mjs prod:import",
    "prod:validate": "node scripts/cloud-wrangler.mjs prod:validate",
    "prod:undo-data": "node scripts/cloud-wrangler.mjs prod:undo-data",
    "prod:undo-tenant": "node scripts/cloud-wrangler.mjs prod:undo-tenant",
    "prod:provision": "node scripts/cloud-wrangler.mjs prod:provision"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "22",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "geist": "^1.9.2",
    "postal-mime": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
