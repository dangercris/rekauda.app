{
  "name": "rekauda",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:api": "node scripts/ensure-config.mjs && wrangler dev --port 8799",
    "dev:web": "node scripts/ensure-config.mjs && vite",
    "build": "node scripts/ensure-config.mjs && vite build",
    "deploy": "node scripts/ensure-config.mjs && wrangler d1 migrations apply DB --remote && vite build && wrangler deploy",
    "types": "node scripts/ensure-config.mjs && wrangler types",
    "typecheck": "node scripts/ensure-config.mjs && tsc -p src/worker/tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit",
    "test": "node scripts/ensure-config.mjs && vitest run",
    "db:migrate:local": "node scripts/ensure-config.mjs && wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/ensure-config.mjs && wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "22",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "geist": "^1.9.2",
    "postal-mime": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
